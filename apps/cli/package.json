{
  "name": "@hsskey/tokenloom",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "A CLI that turns a Figma design into design tokens for three platforms (CSS, Swift, Kotlin) and into a design context for LLM prompts, deterministically.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hsskey/tokenloom.git",
